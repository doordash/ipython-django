#!/usr/bin/env bash
# Scaffolded by batch-pr.sh — chaining shim for hook: pre-commit

# Chain to company-managed hook if present
_dd_hook_type=$(basename "$0")
_dd_company_hook="/Library/DoorDash/git/hook_chains/$_dd_hook_type"
if [ -x "$_dd_company_hook" ] && [ "${__DD_WRAPPER_ACTIVE:-}" != "$_dd_hook_type" ]; then
    "$_dd_company_hook" "$@"
    exit $?
fi
unset __DD_WRAPPER_ACTIVE
